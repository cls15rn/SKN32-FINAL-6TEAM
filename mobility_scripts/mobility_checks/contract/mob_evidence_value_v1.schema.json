        "v": {
          "$ref": "#/$defs/v"
        },
        "kind": {
          "const": "alt"
        },
        "leg_id": {
          "$ref": "#/$defs/leg_id"
        },
        "grade": {
          "$ref": "#/$defs/grade"
        },
        "axis": {
          "enum": [
            "출발시각_이동",
            "노선교체",
            "수단교체",
            "환승역_교체"
          ]
