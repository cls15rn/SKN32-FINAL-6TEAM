          "enum": [
            "subway",
            "bus",
            "taxi",
            "walk",
            "airport_bus",
            "bike",
            "car"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict_value"
        },
        "depart_min": {
          "$ref": "#/$defs/service_min_null"
        },
        "arrive_min": {
          "$ref": "#/$defs/service_min_null"
        },
        "inherits_issue": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          },
          "maxItems": 6
        },
        "note": {
