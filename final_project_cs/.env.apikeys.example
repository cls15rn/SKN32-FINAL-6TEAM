# A-COP — 바깥 데이터 소스 API 키
#
# ★★**이 파일을 `.env.apikeys` 위로 복사하지 마라.** 값이 들어 있는 실제 키
#   파일이 빈 템플릿으로 덮여 사라진다 — 2026-09-10 에 실제로 세 번 났다.
#
#   대신:  python -m scripts.sync_apikeys      (빠진 항목만 덧붙인다)
#   확인:  python -m scripts.sync_apikeys --check
#
# `.env.apikeys` 는 커밋하지 않는다.
#
# ★★여기에 **선언되지 않은 이름을 적으면 앱이 기동조차 못 한다.**
#   `Settings` 가 `extra="forbid"` 라서 `ValidationError` 로 죽는다(2026-09-10 실측).
#   새 키를 넣으려면 `app/core/settings.py` 에 **필드부터 만든다.**
#
# ★읽는 순서: `.env` → `.env.apikeys`. **뒤가 이긴다**(실측 확인).
#   그래서 같은 이름이 양쪽에 있으면 이 파일 값이 쓰인다.
#
# ★비워 두면 그 소스를 **안 붙인다.** 가짜 값으로 채우지 않는다 —
#   Team 은 「모름」으로 escalate 하고, /ui/admin 이 왜 빠졌는지 보여 준다.


# ── 기상 공급자 선택 ─────────────────────────────────────────────
# open_meteo : 키가 **필요 없다**(2026-09-09 실호출 200 확인). 기본값.
#              비상업 하루 10,000 호출 무료라고 공급자가 밝히고 있다 —
#              상업 배포 전 요금제를 다시 확인한다.  https://open-meteo.com/
# kma        : 기상청 단기예보로 바꾼다. 아래 ACOP_KMA_API_KEY 가 필요하다.
ACOP_WEATHER_PROVIDER=open_meteo


# ── 공공데이터포털 공통 인증키 ───────────────────────────────────
# ★계정마다 인증키가 **하나**고, 활용신청을 승인받은 서비스 전부에 같은 키를
#   쓴다. 그래서 **이것만 채우면 아래 서비스가 전부 산다.**
#   서비스별 칸은 **다른 계정을 쓸 때만** 채우는 덮어쓰기 자리다.
#
#   발급: https://www.data.go.kr  가입 → 서비스별 [활용신청] → 마이페이지에서 인증키
#   ★서비스마다 활용신청을 따로 해야 한다. 키는 같아도 승인은 개별이다.
#   ★일반 인증키(Decoding)를 쓴다. Encoding 키를 넣으면 이중 인코딩으로 깨진다.
ACOP_DATA_GO_KR_KEY=


# ── 공공데이터포털 서비스별 (비우면 위 공통 키를 쓴다) ───────────
#
# MVP 에 실제로 필요한 넷 — 2026-09-09 실호출로 엔드포인트 생존 확인(401 = 살아있음)
#
# 한국관광공사 국문 관광정보 — 장소·좌표·운영시간 (read.place 보강)
#   https://www.data.go.kr/data/15101578/openapi.do
ACOP_TOUR_API_KEY=
#
# 한국관광공사 무장애 여행 정보 — 휠체어·엘리베이터·출입구 접근성
#   https://www.data.go.kr/data/15101897/openapi.do
#   ★★**활용신청 완료 2026-09-22.** 그 전에는 403
#     `SERVICE_KEY_IS_NOT_REGISTERED_ERROR` 였다 — 경로가 틀린 게 아니라
#     신청이 안 된 것이었다. (1판 `KorWithService1` 은 폐기, 2판을 쓴다)
#   ★**키 칸을 따로 두지 않는다.** 공통 키(ACOP_DATA_GO_KR_KEY)로 그대로
#     열린다. 이 파일은 선언되지 않은 이름을 적으면 앱이 기동을 못 하므로
#     새 변수를 만들지 않고 여기 주석으로만 남긴다.
#   베이스: https://apis.data.go.kr/B551011/KorWithService2
#     areaBasedList2(목록) · detailWithTour2(무장애 상세) · areaCode2
#   개발계정 1,000/일 · 무료 · 운영단계는 심의승인
#
#   `[실측 2026-09-22]` 등록 수 — 전국 9,638 · 서울 547
#     (서울 관광지 162 · 서울 음식점 105)
#   `[실측]` 서울 30건 표본의 필드 채움률
#     route 83% · exit 83% · restroom 53% · parking 50% · elevator 33%
#     braileblock 27% · helpdog 23% · wheelchair 10%
#     ★유아 쪽은 거의 없다 — stroller 7% · lactationroom 3% · babysparechair 0%
#   ★★**값이 자연어 문장이다.** 예: "출입구까지 턱이 없어 휠체어 접근 가능함".
#     boolean 으로 파싱하지 않는다. usetime·restdate 와 같은 이유다.
#
# 한국천문연구원 특일 정보 — ★공휴일 휴무 판정. "그날 여는가"의 절반이다
#   https://www.data.go.kr/data/15012690/openapi.do
#   ★이동 모듈: 지하철 시간표의 평일/휴일 달력 갱신에도 쓴다(연 1회)
#     쓰는 곳: datasets/mobility/scripts/holiday_collect.py → 엔진 rules/holidays_<시작>_<끝>.json
#   자동승인 · 개발 10,000/일 (2026-10-01 확인)
ACOP_HOLIDAY_API_KEY=
#
# 기상청 기상특보 — ★지속관리 루프의 트리거. 예보는 당길 때 오고 특보는 사건 때 온다
#   https://www.data.go.kr/data/15000415/openapi.do
ACOP_KMA_WARNING_API_KEY=
#
# 기상청 지진정보 — 최근 지진(규모·진앙). ★조회는 오늘 기준 3일 전까지(실측)
#   https://www.data.go.kr/data/15000420/openapi.do
ACOP_KMA_EARTHQUAKE_API_KEY=
#
# 행정안전부 긴급재난문자 — 호우·통제·화재 등 지역 재난문자(지속관리 루프의 사건 소스)
#   https://www.data.go.kr/data/15134001/openapi.do
#   ★키가 없으면 샘플 CSV 판(2023-09 일부)으로만 돈다 — 그 기간 밖은 「미연결」
ACOP_DISASTER_MSG_API_KEY=
#
# 국토교통부 TAGO — 버스·지하철·열차 운행 (read.transit)
#   https://www.data.go.kr/data/15098530/openapi.do   (지하철 15098554 / 열차 별도)
#   ★이동 모듈: 지하철 시간표 갱신에 **지하철정보(15098554)를 따로 활용신청**한다 — 승인은 서비스마다다
#     https://www.data.go.kr/data/15098554/openapi.do   자동승인 · 개발 10,000/일 (2026-10-01 확인)
#     베이스: https://apis.data.go.kr/1613000/SubwayInfo
#     쓰는 곳: datasets/mobility/scripts/tago_subway_collect.py · tago_fix_unmatched.py · tago_retry_empty.py
ACOP_TAGO_API_KEY=
#
# 서울교통공사 지하철알림정보 — ★이동 모듈 사고 감시. 1~8호선 무정차·운행 중단 알림
#   https://www.data.go.kr/data/15144070/openapi.do
#   ★지금은 공통 키(ACOP_DATA_GO_KR_KEY)로 열린다. ★그 계정이 활용신청해야 함
#     (개발계정 자동승인 · 10,000회/일). 신청 안 한 키면 본문 오류가 와서 감시 루프가
#     그 이동 항목을 치명으로 남긴다 — 경로가 틀린 게 아니라 신청이 안 된 것이다
#   베이스: https://apis.data.go.kr/B553766/ntce/getNtceList   갱신 1분(제공처 설명)
#   ★호선·역 코드·상하행이 칸으로 온다. 9호선·공항철도·코레일 전용 구간은 안 나온다
#   ★아래 칸은 **주석으로 둔다** — `app/core/settings.py` 에 필드가 아직 없어서 풀면 앱이
#     기동을 못 한다(맨 위 경고). 필드가 생기면 주석을 푼다(다른 계정을 쓸 때만 채우는 자리)
# ACOP_SUBWAY_ALERT_API_KEY=
#
# 서울특별시 노선정보조회 — ★이동 모듈 버스 노선·정류장 갱신(서울 시내버스 노선 전수 · 노선별 정류장)
#   https://www.data.go.kr/data/15000193/openapi.do
#   ★지금은 공통 키(ACOP_DATA_GO_KR_KEY)로 열린다. 활용신청 필요(자동승인)
#   ★개발 1,000/일로 낮다 — 정류장 전수는 하루에 다 못 받는다(--max-calls 로 며칠에 나눈다)
#   베이스: http://ws.bus.go.kr/api/rest/busRouteInfo
#     쓰는 곳: datasets/mobility/scripts/seoul_bus_find_routes.py
#   ★아래 칸은 **주석으로 둔다** — settings.py 에 필드가 생기면 푼다(위 지하철알림정보와 같음)
# ACOP_SEOUL_BUS_API_KEY=

# 도메인이 넓어지면 필요한 것들
#
# 기상청 단기예보 — Open-Meteo 대안(국내 정확도). ★2년마다 갱신해야 한다
#   https://www.data.go.kr/data/15084084/openapi.do
ACOP_KMA_API_KEY=
#
# 한국환경공단 에어코리아 — 야외활동 대기질(미세먼지). 개발계정 500/일로 낮다
#   https://www.data.go.kr/data/15073861/openapi.do
ACOP_AIRKOREA_API_KEY=
#
# 국립해양조사원 — ★수상레저(서핑·갯벌·낚시·요트) 활동 성립 판정
#   ★키는 공통 키(ACOP_DATA_GO_KR_KEY)로 충분하다. (구)바다누리 자체
#     OpenAPI 는 **종료 예정**이고 공공데이터포털 쪽을 쓰라고 안내한다.
#     아래는 「어느 서비스에 활용신청할지」를 적어 둔 것이다.
#
#   ★★활용신청할 것 둘 (2026-09-10 조사)
#     ① 서핑지수 조회        data.go.kr/data/15142490   개발 10,000/일 · 자동승인
#        → **활동 성립 여부를 기관이 판정해 준다.** 우리가 조위·풍속에서
#          기준을 만들어 내지 않아도 된다 — 그 기준은 우리 근거가 아니다.
#     ② TideBED 예측 조위(1분) data.go.kr/data/15156026  개발 10,000/일 · 자동승인
#        → ★**위도·경도로 조회된다.** 우리 `places` 에는 좌표만 있고
#          관측소 코드가 없다. 나머지 조석 API 는 전부 관측소 코드를 받는다.
#
#   안 쓰기로 한 것 셋 — 우리 질문에 안 맞는다
#     · 조석예보(고·저조 1일)  15038991 : 고/저조 시각만. 그 사이 시각은 우리가
#       보간해야 하는데, 그 보간은 우리가 지어내는 값이 된다
#     · 최극조위(조석성과)             : 월·연 극값. 해안 구조물 설계용
#     · 조위관측소 실측·예측 비교 15142507 : 모델 검증용. 다만 **예보 신뢰도를
#       실측으로 확인**할 때는 이게 정답이다 — 필요해지면 그때 연다
#
#   `[미확보]` 위 둘의 **정확한 엔드포인트 경로**를 확인하지 못했다.
#     2026-09-10 에 기관코드 1192000 아래로 4개 경로를 추측해 호출했으나 전부
#     400 NO_OPENAPI_SERVICE_ERROR 였다 — **경로를 틀린 것이지 API 가 없는
#     것이 아니다.** 각 데이터 페이지의 「오픈API 활용가이드」(.hwp)에 있다.
ACOP_KHOA_API_KEY=
#
# 국가유산청(옛 문화재청) 국가유산 OpenAPI
#   ★★**키가 필요 없다** — 2026-09-10 실호출 확인. 인증 파라미터를 아예 넣지
#     않고 HTTP 200 + 실제 XML 이 온다. www.khs.go.kr / www.cha.go.kr 둘 다.
#     **그래서 이 칸은 비워 두면 된다.** Open-Meteo 에 이어 두 번째 무키 소스다.
#     붙어 있는 곳: app/infrastructure/travel/heritage.py
#
#   ★주는 것 : 위도·경도 · 주소 · 관리기관 · 시대 · 해설
#     안 주는 것: **관람시간 · 휴무일 · 요금** — 「궁·능 관람 정보」로 읽으면
#     과장이다. 운영시간은 TourAPI detailIntro(키 필요)가 대야 한다.
#
#   ★쓰임은 하나 — **좌표를 모르는 장소의 좌표를 채운다.** 좌표가 없으면
#     read.weather 가 아무것도 못 한다(「어디인지 모르는 곳의 날씨」는 없다).
#
#   이 칸은 공공데이터포털 쪽 문화재 공간정보(data.go.kr/data/3070426)를 따로
#   쓸 때만 채운다. 지금 코드는 그쪽을 안 쓴다.
ACOP_HERITAGE_API_KEY=
#
# 한국공항공사 실시간 운항 — Flight 팀 결항·지연
#   https://www.data.go.kr/data/15113771/openapi.do
#   ★[미확보] 2026-09-09 엔드포인트 경로를 확인하지 못했다(400 NO_OPENAPI_SERVICE_ERROR).
#     키를 넣기 전에 정확한 오퍼레이션 경로를 먼저 확인한다.
ACOP_AIRPORT_API_KEY=
#
# 외교부 국가·지역별 여행경보 — 해외 여행으로 확장할 때
#   https://www.data.go.kr/data/15076237/openapi.do
ACOP_MOFA_API_KEY=
#
# 행정안전부 긴급재난문자 — read.disaster (activity.py 「재난문자 등급 대조」)
#   data.go.kr 목록: https://www.data.go.kr/data/15134001/openapi.do
#   ★실제 호출은 재난안전데이터 공유플랫폼에서: https://www.safetydata.go.kr/
#   ★★[미확보 2026-09-20] 이 공통 키로 되는지, safetydata.go.kr 에 별도 가입이
#     필요한지 확인 안 됐다 — 키를 넣어도 첫 실호출 결과를
#     app/infrastructure/travel/disaster_msg.py 모듈 docstring에 반드시 남긴다.
ACOP_DISASTER_API_KEY=


# ── 정부 교통정보 (공공데이터포털 공통 키와 **다른 키**다 — 기관이 따로 발급) ──
#
# 국토교통부 ITS 국가교통정보센터 — 돌발상황정보(고속도로·국도의 사고·공사·통제)
#   https://www.its.go.kr/opendata/   (공공데이터포털 15040465 는 여기로 잇는 LINK 형)
#   ★ITS 마이페이지에서 발급된 키를 넣는다. ACOP_DATA_GO_KR_KEY 로는 안 된다.
ACOP_ITS_API_KEY=
#
# 경찰청 UTIC 도시교통정보센터 — 도로위험상황예보·돌발(시내 행사·집회·통제 포함)
#   https://www.utic.go.kr/
#   ★★**등록한 IP 에서만 호출된다.** 배포 서버·발표장 IP 도 UTIC 에 따로 등록해야 한다.
# 등록한 key 1의 ip : <바로 부르는 자리의 외부 IP>
# 등록한 key 2의 ip : <고정 IP 경유 서버의 IP>
#   ★실제 IP 는 여기(공용)에 적지 않는다 — `.env.apikeys` 에만 적는다
#   ★이름을 _1·_2 로 나눈다 — 같은 이름을 두 줄 쓰면 뒤의 것만 읽힌다
ACOP_UTIC_API_KEY_1=
ACOP_UTIC_API_KEY_2=
#
# 고정 IP 서버 경유 — IP 에 묶인 API(UTIC)를 등록한 서버 IP 로 내보낸다
#   ★서버 주소·계정·접속 방법은 여기(공용)에 적지 않는다 — 각자 `.env.apikeys`·~/.ssh/config 에
#   ACOP_OUTBOUND_PROXY_SOURCES 는 경유시킬 소스 이름(쉼표), * 는 전부
ACOP_OUTBOUND_PROXY_URL=socks5://127.0.0.1:1080
ACOP_OUTBOUND_PROXY_SOURCES=utic


# ── 민간 (공공데이터포털 키와 **다른 키**다. 공통 키가 대신하지 않는다) ──
#
# ODsay 대중교통 길찾기 — read.route · read.transit
#   https://lab.odsay.com/
#   ★★이 공급자는 **인증 실패에도 HTTP 200 을 준다**(2026-09-09 실측).
#     본문에 [ApiKeyAuthFailed] 가 들어온다. 어댑터가 본문까지 검사하도록
#     해 뒀으니 키가 틀려도 조용히 성공으로 지나가지는 않는다.
ACOP_ODSAY_API_KEY=
#
# 카카오 REST API — 주소 → 좌표 보정 (기상 조회에 좌표가 필요하다)
#   https://developers.kakao.com/
ACOP_KAKAO_REST_API_KEY=
#
# 브이월드(국토교통부 공간정보 오픈플랫폼) 지오코더 — 주소 → 좌표 (장소 데이터 좌표 보완)
#   https://www.vworld.kr/  오픈API → 인증키 발급 · 활용API 「지오코더 API」 체크
#   ★인증키에 유효기간이 있다 — 만료되면 사이트에서 연장한다
ACOP_VWORLD_API_KEY=
#
# 구글 Maps Platform — 새벽 3시 하루 점검(식당 영업 여부 등, D-020). ★자리만 만들었다(2026-09-24)
#   https://console.cloud.google.com/google/maps-apis
#   ★비어 있으면 부르지 않는다. 무료 월 1,000건(영업시간 필드는 Enterprise 등급) — 하루 상한은
#     ACOP_RATE_GOOGLE_PLACES_PER_DAY(기본 16). 영업시간 원값은 저장 금지 — 판정·확인 시각만 남긴다
#   ★(2026-09-25) 무료 한도를 넘지 않게 DB 호출 예산이 따로 막는다 — config/guardrails.yaml 의
#     travel.google_budget(영업시간 상세 월 950·하루 30). 키를 **Places API (New) 전용**으로 제한해 둔다
ACOP_GOOGLE_MAPS_API_KEY=
#
# 네이버 검색 API(블로그 · 카페글) — 대체 후보에 후기 몇 건을 곁들인다(2026-10-01)
#   네이버 클라우드 콘솔 > NAVER API HUB 에서 앱을 만들고 검색(블로그 · 카페글)을 고른다
#   ★개발자센터(developers.naver.com) 검색 API 는 2026-07-31 신규 발급 종료 — 거기엔 「검색」이 없다
#   ★네이버 지도 키(웹 NEXT_PUBLIC_NAVER_MAP_CLIENT_ID)와 다른 키다. 비어 있으면 부르지 않는다
#   ★결과는 저장하지 않는다. 하루 상한은 ACOP_RATE_NAVER_SEARCH_PER_DAY(기본 12,500 — 월 775,000건의 절반 아래)
ACOP_NAVER_SEARCH_CLIENT_ID=
ACOP_NAVER_SEARCH_CLIENT_SECRET=
#
# 서울 열린데이터광장 키 — 이동 계산기의 따릉이 실시간 거치 대수(2026-09-29) https://data.seoul.go.kr
#   ★비우면 거치 대수는 근거없음. ★제공처가 http 만 받는다(평문 전송) — 이 키 전용으로 발급해 쓴다
#   자료 폴더·경로 서버 주소는 .env.example 의 ACOP_MOBILITY_* (키가 아니라 서버 설정)
#   발급: https://data.seoul.go.kr 로그인 → 인증키 신청 → 「일반 인증키」(실시간 지하철 키 아님)
#     하나로 이동 모듈 몫이 다 열린다 — 서비스별 신청은 없다
#     따릉이 실시간 대여정보 OA-15493(bikeList) — 거치 대수(판정)
#     역별 시간표 OA-101 · 역 정보 OA-15442 · 첫막차 OA-15492 — 지하철 시간표 갱신
#       쓰는 곳: datasets/mobility/scripts/seoul_metro_collect.py · seoul_fill_holiday.py · seoul_fill_gaps.py
#   ★요청 한 번에 최대 1,000건(제공처 안내)
ACOP_SEOUL_OPENAPI_KEY=
#
# 디스코드 웹훅 — 고객 알림(일정 변경 통지). 채널 설정 → 연동 → 웹후크 → URL 복사
#   ★비어 있으면 알림이 dead_letter 로 남는다(보낸 것으로 기록하지 않는다)
ACOP_DISCORD_WEBHOOK_URL=

# ── 호출 속도 제한 ───────────────────────────────────────────────
# ★★시험한다고 빨리 두들기면 그날치 한도를 태우고 차단당한다.
#   그래서 **하루 한도를 하루에 걸쳐 쓴다.**
#
#       최소 간격(초) = 86400 / 하루 한도
#       10,000/일 → 8.64초    1,000/일 → 86.4초    500/일 → 172.8초
#
#   간격이 안 찼으면 아래 ACOP_RATE_MAX_WAIT_SECONDS 까지만 기다리고,
#   그래도 모자라면 **거부하고 「모름」으로 넘어간다** — 고객 요청 경로에서
#   86초를 자는 것은 실패보다 나쁘기 때문이다. 거부는 세어서 남는다.
#
#   0 을 넣으면 그 소스는 제한 없음이다. **권하지 않는다.**
#
#   ☆값의 출처를 갈라 적었다:
#     「확인」  공급자 문서/상세페이지에서 실제로 본 수
#     「미확인」 확인 못 해서 data.go.kr 개발계정 통상값으로 보수적으로 잡은 수
#
#   ★한 프로세스 안에서만 센다. 여러 프로세스가 같은 키를 쓰면 합계가 한도를
#     넘을 수 있다 — 중앙 카운터는 아직 없다. 이 한계를 알고 쓴다.

# 확인된 한도
ACOP_RATE_OPEN_METEO_PER_DAY=10000
ACOP_RATE_KMA_WARNING_PER_DAY=10000
ACOP_RATE_KMA_EARTHQUAKE_PER_DAY=1000
ACOP_RATE_OPEN_METEO_AIR_PER_DAY=2000
ACOP_RATE_DISASTER_MSG_PER_DAY=1000
ACOP_RATE_UTIC_PER_DAY=1000
ACOP_RATE_KHOA_PER_DAY=10000
ACOP_RATE_AIRKOREA_PER_DAY=500

# 미확인 - 보수적으로 잡았다. 각 서비스 상세페이지에서 확인되면 올린다
ACOP_RATE_TOUR_API_PER_DAY=1000
ACOP_RATE_KASI_HOLIDAY_PER_DAY=1000
ACOP_RATE_TAGO_PER_DAY=1000
ACOP_RATE_KMA_PER_DAY=1000
ACOP_RATE_AIRPORT_PER_DAY=1000
ACOP_RATE_MOFA_PER_DAY=1000
ACOP_RATE_ITS_PER_DAY=1000
ACOP_RATE_ODSAY_PER_DAY=1000
ACOP_RATE_KAKAO_PER_DAY=1000
ACOP_RATE_NAVER_SEARCH_PER_DAY=12500

# 국가유산청은 키가 없고 공개된 한도도 못 찾았다.
# ★한도를 모른다는 것이 마음껏 두들겨도 된다는 뜻은 아니다. 스스로 조인다.
ACOP_RATE_HERITAGE_KHS_PER_DAY=1000

# 유료 전환 가능 — 무료 한도의 **절반**만 쓴다(여유 2배). 월 한도는 31일로 나눈다.
#   Place Details 영업시간 = Enterprise 등급, 무료 월 1,000 → 1,000/31/2 = 16
#   Compute Routes 교통 반영 = Pro 등급, 무료 월 5,000 → 5,000/31/2 = 80
#   (Google Maps Platform 가격표 2026-09-15 조회. 어댑터는 아직 없다)
ACOP_RATE_GOOGLE_PLACES_PER_DAY=16
ACOP_RATE_GOOGLE_ROUTES_PER_DAY=80

# 간격이 안 찼을 때 기다려 볼 최대 시간(초). 고객 요청이 여기서 멈춘다.
ACOP_RATE_MAX_WAIT_SECONDS=5.0
