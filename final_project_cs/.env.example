# A-COP 환경변수 — .env 로 복사해서 채운다. .env 는 커밋하지 않는다.
# ★폴백 금지(RULE.md §3.2): 아래 값이 없으면 예외를 던지고 멈춘다. 기본값으로 조용히 대체하지 않는다.

# ── DB ───────────────────────────────────────────────────────
# PostgreSQL 16.14 (conda env `pgv`, Windows 서비스 아님 — docs/manuals/ 참조)
ACOP_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/acop_cs

# ── LLM ──────────────────────────────────────────────────────
ACOP_LLM_PROVIDER=openai
ACOP_OPENAI_API_KEY=
# Anthropic Claude API 키(자리만 — 아직 읽는 코드 없음). 값은 .env 에만 둔다.
ACOP_CLAUDE_API_KEY=
ACOP_LLM_MODEL=gpt-4o-mini
# 임베딩 차원은 config/guardrails.yaml (rag.embedding_dim=1536) 과 DDL vector(1536) 이 함께 정한다.
# 모델을 바꾸면 DDL 과 적재분도 함께 바꿔야 한다.
ACOP_EMBEDDING_MODEL=text-embedding-3-small
# 정책 검색(RAG)의 임베딩을 어디서 만드나 — openai | ollama
#  ★openai 는 위 모델(1536차원, `embedding` 칸), ollama 는 bge-m3(1024차원, `embedding_1024` 칸).
#    고른 쪽 칸이 비어 있으면 검색이 예외를 낸다 — 조용히 다른 칸으로 넘어가지 않는다.
#    ollama 로 쓰려면 `python -m scripts.embed_chunks_local` 로 칸을 먼저 채운다.
ACOP_EMBEDDING_PROVIDER=openai
ACOP_OLLAMA_EMBEDDING_MODEL=bge-m3:latest
# 로컬 언어 모델(Ollama) — 주소(ACOP_OLLAMA_BASE_URL)를 채우면 분류·추출·번역·요청 해석을 이 모델로 한다. 실제 주소는 .env 에만 둔다 `[2026-10-14]`
#  ★코드 기본 모델은 우리 데이터로 가르친 E4B `tripilot-pointer:e4b-ft` 다(전에는 gemma4:12b). 이 모델은 우리가 Ollama 에 올려 둔 곳에만 있다.
#    개발 PC 의 Ollama 에 없으면 호출이 "모델 없음" 으로 실패한다 → 아래 줄로 **있는 모델**을 지정한다(예 gemma4:12b). 실패는 이전과 같이 「모름」으로 기록된다.
#ACOP_OLLAMA_MODEL=gemma4:12b
# 문맥 길이 — 기본 8192(요청 해석 입력이 약 4,600 토큰이라 Ollama 기본 4,096 이면 앞이 잘린다). 모델을 바꿔도 그대로 둔다
#ACOP_OLLAMA_NUM_CTX=8192

# 모델 서버(Ollama · GPU 서버)가 모두 죽거나 늦으면 **서버용 OpenAI 키**(ACOP_OPENAI_API_KEY_SERVER — 개인 키와 다른 키)로 자동 전환 `[2026-10-07]`
#  ★기본 꺼짐 — 개발 PC 에서 연결이 끊겼을 때 시험 · 측정이 조용히 유료 API 로 새지 않게. **배포(운영) 환경 파일에서만** true 로 한다.
#  ★켜져 있어도 서버용 키가 비어 있으면 넘기지 않는다. 설명 wiki/external/llm-failover.md
ACOP_LLM_FAILOVER_ENABLED=false
# 서버용 키 — 값은 배포 환경 파일에만 둔다(이 템플릿에는 비워 둔다)
ACOP_OPENAI_API_KEY_SERVER=
# 넘길 때 쓸 OpenAI 모델 — 기본 gpt-4.1(결정 단위 재생 실제 대화 64/66 = Gemma 와 같음 · gpt-4.1-mini 55 · gpt-4o-mini 52). 비우면 ACOP_LLM_MODEL
ACOP_LLM_FAILOVER_MODEL=gpt-4.1
# Ollama 가 둘 이상이면(예: 무료 서버 + GPU 서버) 쉼표로 이어 적는다 — 앞에서부터 시도하고 모두 안 되면 API. 값은 이 파일에 적지 않고 .env 에만 둔다
ACOP_OLLAMA_FALLBACK_BASE_URLS=
# 사진 · 스캔 받아쓰기(이미지)도 API 로 넘길지 — 이미지에는 이름 · 예약번호가 그대로 있어 가릴 수 없다. 기본 꺼짐
ACOP_LLM_FAILOVER_VISION=false
# 기다리는 시간(초) · 서킷 · 일 월 상한 — 기본값은 app/core/settings.py (primary 9 · api 8 · 전체 15 · 연속 실패 3 · 열림 60초 · 일 2000 · 월 30000)
#ACOP_LLM_FAILOVER_PRIMARY_TIMEOUT_SECONDS=9
#ACOP_LLM_FAILOVER_API_TIMEOUT_SECONDS=8
#ACOP_LLM_FAILOVER_TOTAL_SECONDS=15
#ACOP_LLM_FAILOVER_FAILURES=3
#ACOP_LLM_FAILOVER_OPEN_SECONDS=60
#ACOP_LLM_FAILOVER_DAILY_CAP=2000
#ACOP_LLM_FAILOVER_MONTHLY_CAP=30000

# 평가 재현성 — 실행 조건은 리포트에 그대로 적는다(RULE.md §1.4)
ACOP_LLM_TEMPERATURE=0.0
ACOP_LLM_SEED=7
# 활동 판정 LLM(D-CS-015) — rule | shadow | llm. 비워 두면 기본값(rule · gpt-5.4-nano · low · 웹 검색 켬).
# 섀도 기록을 모을 환경만 shadow 로 켠다 — 성립 판정마다 백그라운드 LLM 호출(웹 검색 건당 약 $0.03)이 나간다.
# ACOP_ACTIVITY_JUDGE_MODE=shadow
# ACOP_ACTIVITY_JUDGE_MODEL=gpt-5.4-nano
# ACOP_ACTIVITY_JUDGE_REASONING_EFFORT=low
# ACOP_ACTIVITY_JUDGE_WEB_SEARCH=true

# ── 앱 ───────────────────────────────────────────────────────
ACOP_ENV=dev
ACOP_TENANT_ID=demo
# 감사·API key hashing 용. 운영에서는 반드시 교체한다.
ACOP_SECRET_KEY=change-this-to-a-long-random-secret
ACOP_COMPOSER_JWT_SECRET=replace-with-a-long-random-composer-signing-secret
ACOP_COMPOSER_ISSUER_SECRET=replace-with-a-long-random-composer-issuer-secret

# ── 경로 ─────────────────────────────────────────────────────
ACOP_GUARDRAILS_PATH=config/guardrails.yaml

# ── 여행 외부 소스 ───────────────────────────────────────────
# ★키는 이 파일이 아니라 **`.env.apikeys`** 에 넣는다(2026-09-10 분리).
#   형식과 발급처 링크는 `.env.apikeys.example` 에 있다.
#   읽는 순서는 `.env` → `.env.apikeys` 이고 **뒤가 이긴다**.
#
#   따로 둔 이유: 팀원마다 발급 상태가 다르고 승인 대기 중인 키가 섞이면
#   `.env` 전체를 주고받게 된다. 키만 갈아끼울 수 있어야 한다.

# ── 웹 남용 방어 (2026-09-28, `app/domains/travel_ops/modules/web_account/web_guard.py`) ────────────
# 사람 확인(Cloudflare Turnstile) 비밀키. 비우면 확인을 건너뛰고 응답에 human_check=skipped(개발).
#   개발 시험 키(Cloudflare 공개 값): 1x0000000000000000000000000000000AA 항상 통과 · 2x0000000000000000000000000000000AA 항상 실패
#   실제 비밀키는 Cloudflare 대시보드에서 받아 로컬 `.env` 에만 둔다.
ACOP_TURNSTILE_SECRET=
# true 면(또는 ACOP_ENV=prod 면) 비밀키 없이 서버가 뜨지 않는다
ACOP_TURNSTILE_REQUIRED=false
# 있으면 Cloudflare 가 돌려준 hostname 이 이 중 하나여야 통과(쉼표로 여럿)
ACOP_TURNSTILE_HOSTNAMES=
# 역방향 프록시 주소(쉼표). 여기서 온 요청만 X-Forwarded-For 의 원 주소를 믿는다
ACOP_TRUSTED_PROXIES=
# ── 소셜 로그인(구글) — 업체 콘솔에서 사람이 만든 값. ★둘 다 있어야 켜진다(없으면 GET /v1/web/auth/providers 가 빈 목록). 실제 값은 .env 에만 ──
ACOP_GOOGLE_CLIENT_ID=
ACOP_GOOGLE_CLIENT_SECRET=
# 로그인이 끝나면 브라우저를 돌려보낼 웹 주소(출처만 — 예: 웹 화면 출처). 비우면 ACOP_WEB_ALLOWED_ORIGINS 의 첫 값
ACOP_WEB_ORIGIN=
# ── 「디스코드로 연결」(알림 웹훅 자동 연결) — 디스코드 개발자 포털에서 사람이 만든 앱의 값. ★둘 다 있어야 켜진다(없으면 GET /v1/web/profile 의 discord_connect.available 이 false). 실제 값은 .env 에만 ──
# 디스코드 앱 설정(OAuth2 → Redirects)에 <공개 주소>/v1/web/profile/discord/connect/callback 을 등록해야 한다. 따라 하기: wiki/records/plans/2026-10-05_디스코드_앱_만들기_안내.md
ACOP_DISCORD_CLIENT_ID=
ACOP_DISCORD_CLIENT_SECRET=
# ── 「텔레그램으로 알림 받기」 — @BotFather 에서 사람이 만든 봇의 값. ★셋 다 있어야 켜진다(없으면 GET /v1/web/profile 의 telegram_connect.available 이 false). 실제 값은 .env 에만 ──
# 토큰은 비밀번호처럼 다룬다(로그 · 채팅 · 문서 · 커밋에 쓰지 않는다). 아이디는 @ 없이(예: 이름_bot). 웹훅 비밀값은 우리가 정한 A-Z a-z 0-9 _ - 1~256자
# 운영 봇과 시험 봇은 환경 파일이 따로다 — 시험 봇 토큰은 개발 환경에만. 웹훅 등록은 배포 뒤 `python -m scripts.telegram_set_webhook`
ACOP_TELEGRAM_BOT_TOKEN=
ACOP_TELEGRAM_BOT_USERNAME=
ACOP_TELEGRAM_WEBHOOK_SECRET=

# ── 운영 앱(운영자 콘솔) — 고객 API 앱과 다른 프로세스 (2026-09-29, `app/ops_entrypoint.py`) ────────────
# 실행: python -m app.ops_entrypoint   (127.0.0.1 에만 묶는다 — 다른 주소는 거부. 원격은 SSH 터널)
ACOP_OPS_PORT=8070
# 운영 화면(승인·위임·바깥함)이 부르는 고객 API 주소
ACOP_OPS_API_BASE_URL=http://127.0.0.1:8042
# 운영 앱이 고객 API 를 부를 scope 키(JSON). ★운영 앱 서버의 로컬 .env 에만 둔다
#   형식: {"action:approve": "<키>", "delegation:read": "<키>", "delegation:write": "<키>"}
ACOP_OPS_API_KEYS=
# 운영 화면의 조회 전용 DB 주소(읽기 전용 계정 — 만드는 법 scripts/sql/ops_readonly_role.sql). 비우면 본 DB 주소
ACOP_OPS_READ_DATABASE_URL=

# ── 이동 계산기(이동 담당 엔진, app/domains/travel_ops/instances/mobility/engine) — 2026-09-29 ────────────
# 시간표·역 순서·환승 거리 가공 자료 폴더. 비우면 이동 계산기를 쓰지 않는다.
#   저장소 안 자리: datasets/mobility/processed (이동 담당이 develop 에 올린 자료 18파일 · 148MB) — 상대 경로는 저장소 맨 위 기준
#   드라이브 폴더를 쓰려면 그 폴더(끝에 travel/processed 가 붙는 DATA_DIR 모양) 또는 processed 폴더 경로를 적는다
#   확인: python -m app.domains.travel_ops.instances.mobility.engine.datacheck
ACOP_MOBILITY_DATA_DIR=datasets/mobility/processed
# 자전거·도보 경로 서버(GraphHopper) 주소. 비우면 자전거 소요는 근거없음   ★실제 주소는 로컬 .env 에만
ACOP_MOBILITY_GH_URL=
# 서버 없이 파이썬으로 길찾기(2026-10-04) — 위 GraphHopper 주소가 비어 있을 때 저장소 안 도로 그래프(datasets/mobility/processed/mobility/road_graph_v2 — 없으면 v1)로
#   택시·자전거·장소 사이 도보를 직접 계산한다. 서버 기동 직후 백그라운드로 자료를 올린다(약 7~16초 · 250~350MB). false 면 끈다
ACOP_MOBILITY_LOCAL_ROUTER=true
