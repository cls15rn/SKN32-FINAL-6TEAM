# 비밀
.env
.env.local
*.key
# ★바깥 데이터 소스 API 키. `*.key` 도 `.env` 도 이 이름을 **안 잡는다** —
#   `*.key` 는 `.key` 로 끝나는 이름만, `.env` 는 그 이름 하나만 매치한다.
#   그래서 명시한다. 템플릿(`.env.apikeys.example`)은 커밋한다.
.env.apikeys

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# 평가 산출물 (raw 는 크고 재생성 가능 — report md 만 커밋한다)
eval/reports/raw*.jsonl
eval/reports/pairs*.jsonl

# 지식 원문 중 외부 저작물이 섞이면 여기로 (현재 corpus 는 자체 작성분이라 커밋한다)
knowledge/raw/

# 로컬 DB 덤프
*.dump
*.sqlite3

# Docker
docker/

# OS
Thumbs.db
.DS_Store

# 런타임 산출물 — Composer 감사·이력 JSONL 이 여기 쌓인다.
# ★sample 은 이미 `var/` 를 무시하는데 이쪽만 빠져 있었다(2026-09-06 발견).
#   운영 기록이지 소스가 아니고, 저장소마다 내용이 달라 커밋하면 늘 충돌한다.
var/

# test용
.*/

# graphify 지식그래프 산출물 (생성물, 용량 큼)
graphify-out/
